{
 "prettier": {
  "parser": ""
 },
 "icon_theme": {
  "mode": "light",
  "light": "Zed (Default)",
  "dark": "Zed (Default)"
 },
 "git": {
  "inline_blame": {
   "location": "status_bar"
  }
 },
 "buffer_font_weight": 400.0,
 "buffer_font_family": ".ZedMono",
 "default_open_behavior": "new_window",
 "redact_private_values": false,
 "helix_mode": false,
 "tab_size": 4,
 "git_panel": {
  "tree_view": true
 },
 "active_pane_modifiers": {
  "border_size": 0.0,
  "inactive_opacity": 1.0
 },
 "use_system_window_tabs": false,
 "focus_follows_mouse": {
  "enabled": false
 },
 "tabs": {
  "file_icons": false,
  "git_status": true
 },
 "tab_bar": {
  "show_pinned_tabs_in_separate_row": false,
  "show_tab_bar_buttons": true,
  "show_nav_history_buttons": true,
  "show": true
 },
 "sticky_scroll": {
  "enabled": true
 },
 "title_bar": {
  "show_branch_status_icon": true,
  "show_branch_name": true,
  "show_project_items": true,
  "show_onboarding_banner": true,
  "show_user_menu": false,
  "show_sign_in": false,
  "show_user_picture": true,
  "show_menus": false
 },
 "languages": {
  "JavaScript": {
   "hard_tabs": false
  },
  "YAML": {
   "hard_tabs": false,
   "tab_size": 2
  },
  "JSON": {
   "hard_tabs": false,
   "tab_size": 1
  },
  "JSONC": {
   "hard_tabs": false,
   "tab_size": 1
  },
  "Python": {
   "language_servers": ["!basedpyright", "ruff", "ty"]
  }
 },
 "lsp": {
  "basedpyright": {
   "initialization_options": {
    "settings": {
     "python": {
      "analysis": {
       "typeCheckingMode": "off"
      }
     }
    }
   }
  }
 },
 "hard_tabs": true,
 "which_key": {
  "enabled": true,
  "delay_ms": 0
 },
 "project_panel": {
  "dock": "right",
  "default_width": 250.0,
  "hide_gitignore": false,
  "entry_spacing": "standard",
  "indent_size": 10.0,
  "hide_hidden": false,
  "hide_root": true,
  "indent_guides": {
   "show": "always"
  },
  "sticky_scroll": true,
  "diagnostic_badges": false,
  "git_status_indicator": true,
  "scrollbar": {
   "horizontal_scroll": true
  }
 },
 "format_on_save": "off",
 "vim": {
  "use_system_clipboard": "on_yank",
  "toggle_relative_line_numbers": true
 },
 "toolbar": {
  "agent_review": false,
  "selections_menu": true,
  "quick_actions": false,
  "breadcrumbs": true
 },
 "scrollbar": {
  "diagnostics": "error",
  "cursors": true,
  "show": "auto"
 },
 "gutter": {
  "min_line_number_digits": 4
 },
 "show_wrap_guides": true,
 "rounded_selection": true,
 "buffer_line_height": "comfortable",
 "relative_line_numbers": "disabled",
 "cli_default_open_behavior": "new_window",
 "telemetry": {
  "diagnostics": false,
  "metrics": false
 },
 "vim_mode": true,
 "terminal": {
  "max_scroll_history_lines": 10000
 },
 "base_keymap": "VSCode",
 "minimap": {
  "thumb": "always",
  "show": "never"
 },
 "ui_font_size": 13.0,
 "buffer_font_size": 12.0,
 "command_aliases": {
  "wf": "workspace::FormatAndSave"
 },
}
